<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/_next/static/" next_hashed_asset=1
</IfModule>

<IfModule mod_headers.c>
  # Route documents and Next route data must reflect each deployment immediately.
  <FilesMatch "\.(?:html?|txt)$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>

  # Runtime-sensitive metadata may be stored only when it is revalidated.
  <FilesMatch "\.(?:json|webmanifest|xml)$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Public assets use stable filenames, so keep their browser lifetime bounded.
  <FilesMatch "\.(?:css|js|mjs|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|otf)$">
    Header always set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>

  # Next emits content-hashed files under this path; these alone are immutable.
  Header always set Cache-Control "public, max-age=31536000, immutable" env=next_hashed_asset
</IfModule>
