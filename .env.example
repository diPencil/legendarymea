# Public form receiver. Must accept the documented JSON contract and return
# HTTP 2xx with: { "reference": "REAL-PERSISTED-REFERENCE" }
TRAVEL_REQUEST_WEBHOOK_URL=https://your-backend.example.com/api/travel-requests

# Shared bearer/HMAC secret between this website and the receiving endpoint.
TRAVEL_REQUEST_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Used only to sign the short-lived, HttpOnly request-form nonce cookie.
TRAVEL_REQUEST_SIGNING_SECRET=replace-with-a-different-long-random-secret

# Comma-separated exact browser origins allowed to submit the public form.
TRAVEL_REQUEST_ALLOWED_ORIGINS=https://legendarymea.com,https://www.legendarymea.com

# Canonical production URL used by metadata, Open Graph, robots and sitemap.
NEXT_PUBLIC_SITE_URL=https://legendarymea.com

# Same-origin browser API path used by the internal dashboard.
NEXT_PUBLIC_API_BASE_URL=/dashboard-api

# Laravel backend origin used by the internal dashboard proxy.
DASHBOARD_API_BASE_URL=https://api.legendarymea.com
